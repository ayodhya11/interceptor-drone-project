# Copy this file to ".env" and fill in your key.
# .env is git-ignored so your key never gets committed.
ROBOFLOW_API_KEY=your_roboflow_api_key_here
ROBOFLOW_MODEL_ID=drone-uskpc/1
ROBOFLOW_API_URL=https://serverless.roboflow.com

# Detection tuning
# Raise this if the model flags people/background as drones (try 0.75-0.85).
CONFIDENCE_THRESHOLD=0.65
# Comma-separated class names to accept; leave as "drone" to ignore any other
# class the model might emit.
CLASS_FILTER=drone

# Optional
WEBCAM_INDEX=0
FLASK_SECRET=change-this-secret-key
